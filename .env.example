# SQLite for local dev; use Postgres anywhere concurrent writes matter:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inventory
DATABASE_URL=sqlite:///./inventory.db
USERS_API_URL=https://laravel.example.com
USERS_API_TOKEN=your-sanctum-token
USERS_API_TIMEOUT=5
# Auth: callers' Sanctum tokens are checked via Laravel GET /api/user
AUTH_ADMIN_FIELD=role
AUTH_ADMIN_VALUES=admin
AUTH_CACHE_TTL=60
